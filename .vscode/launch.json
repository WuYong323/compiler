{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试 coolc（编译 factorial.cl）",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/coolc.exe",
            "args": ["tests/factorial.cl", "-o", "factorial.ll"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "启用 gdb 整齐打印（看 STL 容器）",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "构建 coolc"
        },
        {
            "name": "调试 coolc（打印 AST）",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/coolc.exe",
            "args": ["tests/list.cl", "--dump"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "启用 gdb 整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "构建 coolc"
        }
    ]
}
